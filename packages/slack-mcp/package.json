{
  "name": "ta-ops-slack-mcp",
  "version": "1.0.0",
  "description": "MCP server for Slack DM delivery \u2014 TA Ops Bot",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ta-ops-slack-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "verify": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "slack",
    "recruiting",
    "ta-ops"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
